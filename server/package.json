{
  "name": "@cueline/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cueline WebSocket server: streams audio to Deepgram, detects questions and streams LLM answers.",
  "scripts": {
    "dev": "node --env-file-if-exists=../.env --watch src/index.ts",
    "start": "node src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "simulate": "node scripts/simulate.ts",
    "make-audio": "node scripts/make-test-audio.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@cueline/shared": "*",
    "@google/genai": "^2.32.0",
    "openai": "^7.45.1",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/ws": "^8.18.2",
    "typescript": "^5"
  }
}
