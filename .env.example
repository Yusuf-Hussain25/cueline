# Cueline configuration. Copy to .env (cp .env.example .env) and fill in the two keys.
# Both providers have free tiers that need no credit card.

# ---------- Speech-to-text: Deepgram (required) ----------
# console.deepgram.com → sign up → API Keys → Create a New API Key → copy it here.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# Silence (ms) before Deepgram decides the speaker finished. Lower = faster, but cuts people off.
ENDPOINTING_MS=500
# Backup end-of-turn signal (ms) that still fires when background noise defeats endpointing.
UTTERANCE_END_MS=1000

# ---------- LLM: any ONE of these providers ----------
# Fill in the key for the provider you have. With LLM_PROVIDER empty, the first provider with a key
# wins, in this order (fastest first token first): groq, anthropic, openai, gemini, deepseek.
LLM_PROVIDER=

# Groq (free, fastest): console.groq.com → API Keys → Create API Key
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant

# Anthropic: console.anthropic.com → Settings → API Keys → Create Key
# Answers run at low effort for speed; set ANTHROPIC_MODEL=claude-haiku-5-5 for the fastest Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_CLASSIFIER_MODEL=claude-haiku-5-5

# OpenAI: platform.openai.com/api-keys → Create new secret key
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CLASSIFIER_MODEL=gpt-4.1-nano

# Gemini (free tier): aistudio.google.com/apikey → Create API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite

# DeepSeek: platform.deepseek.com → API keys (works, but usually the slowest first token)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_CLASSIFIER_MODEL=deepseek-chat

# How many earlier question/answer pairs are sent with each new question (conversation memory).
MEMORY_TURNS=4

# ---------- Server ----------
PORT=8787
# Browser origins allowed to open a session (comma separated).
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Web app ----------
# Where the browser finds the server. Read by Next.js at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
