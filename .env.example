# Cueline configuration. Copy to .env (cp .env.example .env) and fill in the two keys.
# Both providers have free tiers that need no credit card.

# ---------- Speech-to-text: Deepgram (required) ----------
# console.deepgram.com → sign up → API Keys → Create a New API Key → copy it here.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# Silence (ms) before Deepgram decides the speaker finished. Lower = faster, but cuts people off.
ENDPOINTING_MS=500
# Backup end-of-turn signal (ms) that still fires when background noise defeats endpointing.
UTTERANCE_END_MS=1000

# ---------- LLM: Groq (default) or Gemini ----------
# groq = fastest first token (recommended) · gemini = alternative free tier.
# Leave empty to pick whichever provider has a key.
LLM_PROVIDER=groq

# console.groq.com → sign in → API Keys → Create API Key → copy it here.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_CLASSIFIER_MODEL=llama-3.1-8b-instant

# aistudio.google.com/apikey → Create API key → copy it here (only needed with LLM_PROVIDER=gemini).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_CLASSIFIER_MODEL=gemini-2.5-flash-lite

# How many earlier question/answer pairs are sent with each new question (conversation memory).
MEMORY_TURNS=4

# ---------- Server ----------
PORT=8787
# Browser origins allowed to open a session (comma separated).
ALLOWED_ORIGINS=http://localhost:3000

# ---------- Web app ----------
# Where the browser finds the server. Read by Next.js at build time.
NEXT_PUBLIC_SERVER_URL=http://localhost:8787
